{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConectarSoloComoSuThing",
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:us-east-1:<ID_CUENTA>:client/${iot:Connection.Thing.ThingName}",
      "Condition": {
        "Bool": { "iot:Connection.Thing.IsAttached": "true" }
      }
    },
    {
      "Sid": "PublicarYRecibirEnSuShadow",
      "Effect": "Allow",
      "Action": ["iot:Publish", "iot:Receive"],
      "Resource": "arn:aws:iot:us-east-1:<ID_CUENTA>:topic/$aws/things/${iot:Connection.Thing.ThingName}/shadow/*"
    },
    {
      "Sid": "SuscribirseASuShadow",
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": "arn:aws:iot:us-east-1:<ID_CUENTA>:topicfilter/$aws/things/${iot:Connection.Thing.ThingName}/shadow/*"
    }
  ]
}
