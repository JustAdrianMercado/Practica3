# PlatformIO: compilaciones, bibliotecas descargadas y archivos generados
.pio/
.pioenvs/
.piolibdeps/
/build/
/dist/

# VS Code: archivos generados o locales; conservar extensions.json y tasks.json
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
.vscode/*.log
.idea/

# Python: entornos virtuales, cache y empaquetado
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Lambda: carpeta de dependencias instaladas y zip de despliegue (se generan localmente)
/lambda/paquete/
*.zip

# Credenciales y configuracion privada: versionar solo plantillas *.ejemplo.* sin secretos
/firmware/include/ConfiguracionWifi.h
/firmware/include/ConfiguracionAws.h
.env
.env.*
!.env.example
secrets.*
credentials.json
config.local.*

# Certificados y claves del Thing (AWS IoT). Guardarlos en certificados-privados/, fuera de Git.
certificados-privados/
*.pem.key
*-private.pem.key
*-public.pem.key
*-certificate.pem.crt
*.key
*.p12
*.pfx
*.jks
*.keystore

# Credenciales de AWS: nunca deben estar en el repositorio
.aws/
*accessKeys*.csv
*_credentials.csv

# Logs y archivos temporales
*.log
*.tmp
*.bak
*.swp
*~

# Evidencias AWS: conservar originales privados localmente y publicar para-informe/.
/docs/evidencias/mateo-lambda/*.png

# Archivos del sistema operativo
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
